{
  "uid": "orderflow-logs",
  "title": "OrderFlow / Logs",
  "description": "Loki logs for api and worker. Filter by correlation id or order id to follow one flow.",
  "tags": [
    "orderflow",
    "logs"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/orderflow-overview",
      "icon": "dashboard"
    },
    {
      "title": "Worker & Kafka",
      "type": "link",
      "url": "/d/orderflow-worker",
      "icon": "dashboard"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "service",
        "label": "Service",
        "multi": true,
        "includeAll": true,
        "query": "api,worker",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "allValue": "api|worker"
      },
      {
        "type": "custom",
        "name": "level",
        "label": "Level",
        "multi": true,
        "includeAll": true,
        "query": "critical,error,warning,information,debug,trace",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "allValue": ".+"
      },
      {
        "type": "textbox",
        "name": "correlation_id",
        "label": "Correlation id",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "type": "textbox",
        "name": "order_id",
        "label": "Order id",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "type": "textbox",
        "name": "search",
        "label": "Line contains",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Volume",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Log lines by level",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (level) (count_over_time({service_name=~\"$service\", level=~\"$level\"} | correlation_id=~\"(?i).*$correlation_id.*\" | order_id=~\"(?i).*$order_id.*\" |~ \"(?i)$search\" [$__auto]))",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Warnings and errors by service",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service_name) (count_over_time({service_name=~\"$service\", level=~\"warning|error|critical\"} | correlation_id=~\"(?i).*$correlation_id.*\" | order_id=~\"(?i).*$order_id.*\" |~ \"(?i)$search\" [$__auto]))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "row",
      "id": 4,
      "title": "Lines",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "Logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Worker lines carry the id the worker assigned, which may differ from the API's correlation id; search by order id to see both halves.",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"$service\", level=~\"$level\"} | correlation_id=~\"(?i).*$correlation_id.*\" | order_id=~\"(?i).*$order_id.*\" |~ \"(?i)$search\"",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "id": 5,
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 10
      }
    },
    {
      "type": "row",
      "id": 6,
      "title": "Other containers",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "Infrastructure containers (postgres, redis, kafka, observability stack)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"postgres|redis|kafka|prometheus|loki|grafana|alloy\"} |~ \"(?i)$search\"",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "id": 7,
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 31
      }
    }
  ]
}
