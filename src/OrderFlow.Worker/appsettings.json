{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=orderflow;Username=orderflow;Password=orderflow;Maximum Pool Size=30"
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "ProductTtlSeconds": 600,
    "ConnectTimeoutMs": 1000
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "orders.events",
    "DeadLetterTopic": "orders.failed",
    "ConsumerGroupId": "orderflow-worker",
    "LingerMs": 500,
    "QueueBufferingMaxMessages": 500000,
    "MaxRetryAttempts": 3,
    "RetryBaseDelaySeconds": 2,
    "SessionTimeoutMs": 10000,
    "MaxPollIntervalMs": 300000
  }
}
